  const rb=document.getElementById('f-results-breakdown');
  rb.innerHTML=[{label:'Win',count:wins.length,color:'var(--green)'},{label:'Loss',count:losses.length,color:'var(--red)'},{label:'Skipped',count:ft.filter(s=>s.decision==='skipped').length,color:'var(--amber)'}].map(r=>`<div style="margin-bottom:12px;"><div style="display:flex;justify-content:space-between;margin-bottom:4px;"><span style="font-size:12px;color:var(--text2)">${r.label}</span><span style="font-size:12px;color:${r.color};font-weight:600">${r.count} (${((r.count/total)*100).toFixed(0)}%)</span></div><div style="height:6px;background:var(--bg4);border-radius:3px;overflow:hidden;"><div style="height:100%;width:${(r.count/total)*100}%;background:${r.color};border-radius:3px;"></div></div></div>`).join('');
  const stratMap={};
  taken.forEach(s=>{if(!stratMap[s.strategy])stratMap[s.strategy]={w:0,t:0};stratMap[s.strategy].t++;if(WIN_OUTCOMES_A.includes(s.outcome))stratMap[s.strategy].w++;});
  const swr=document.getElementById('f-strat-wr-breakdown');
  swr.innerHTML=Object.entries(stratMap).sort((a,b)=>(b[1].w/b[1].t)-(a[1].w/a[1].t)).map(([name,d])=>{const wr=((d.w/d.t)*100).toFixed(0);return`<div style="margin-bottom:10px;"><div style="display:flex;justify-content:space-between;margin-bottom:3px;"><span style="font-size:11px;color:var(--text2)">${name}</span><span style="font-size:11px;color:${wr>=60?'var(--green)':wr>=50?'var(--amber)':'var(--red)'}">${wr}% (${d.t})</span></div><div style="height:5px;background:var(--bg4);border-radius:3px;overflow:hidden;"><div style="height:100%;width:${wr}%;background:${wr>=60?'var(--green)':wr>=50?'var(--amber)':'var(--red)'};border-radius:3px;"></div></div></div>`}).join('')||'<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">No closed trades</div>';
  const symMap={};
  taken.forEach(s=>{if(!symMap[s.symbol])symMap[s.symbol]={w:0,t:0,pnl:0};symMap[s.symbol].t++;if(WIN_OUTCOMES_A.includes(s.outcome))symMap[s.symbol].w++;symMap[s.symbol].pnl+=(s.pnl_usd||0);});
  const sb=document.getElementById('f-symbol-breakdown');
  sb.innerHTML=Object.entries(symMap).sort((a,b)=>b[1].pnl-a[1].pnl).map(([sym,d])=>{const wr=d.t?((d.w/d.t)*100).toFixed(0):0;return`<div style="margin-bottom:10px;"><div style="display:flex;justify-content:space-between;margin-bottom:3px;"><span style="font-size:11px;color:var(--accent2)">${sym}</span><span style="font-size:11px;color:${d.pnl>=0?'var(--green)':'var(--red)'}">${wr}% | $${d.pnl.toFixed(2)}</span></div><div style="height:5px;background:var(--bg4);border-radius:3px;overflow:hidden;"><div style="height:100%;width:${wr}%;background:${wr>=60?'var(--green)':wr>=50?'var(--amber)':'var(--red)'};border-radius:3px;"></div></div></div>`}).join('')||'<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">No data</div>';
  const totalPnl=ft.reduce((s,sig)=>s+(sig.pnl_usd||0),0);
  const avgWin=wins.length?(wins.reduce((s,sig)=>s+Math.abs(sig.pnl_usd||0),0)/wins.length).toFixed(2):0;
  const avgLoss=losses.length?(losses.reduce((s,sig)=>s+Math.abs(sig.pnl_usd||0),0)/losses.length).toFixed(2):0;
  document.getElementById('f-perf-summary').innerHTML=[
    {label:'Total P&L',val:(totalPnl>=0?'$':'-$')+Math.abs(totalPnl).toFixed(2),color:totalPnl>=0?'var(--green)':'var(--red)'},
    {label:'Avg Win',val:'$'+avgWin,color:'var(--green)'},
    {label:'Avg Loss',val:'$'+avgLoss,color:'var(--red)'},
    {label:'Entered',val:taken.length,color:'var(--accent2)'},
    {label:'Skipped',val:ft.filter(s=>s.decision==='skipped').length,color:'var(--amber)'},
  ].map(s=>`<div style="text-align:center;background:var(--bg3);padding:14px;border-radius:8px;"><div style="font-size:10px;color:var(--text3);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;">${s.label}</div><div style="font-family:var(--font-head);font-size:18px;font-weight:700;color:${s.color}">${s.val}</div></div>`).join('');
}

// ══════════════════════════════════════════════════════════
// SHARED: EQUITY CURVE
// ══════════════════════════════════════════════════════════
function drawEquityCurve(list, canvasId, lineColor, pnlFn) {
  pnlFn = pnlFn || (t => t.pnl||0);
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const wrap = canvas.parentElement;
  canvas.width = wrap.offsetWidth || 400;
  canvas.height = 150;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const sorted = [...list].filter(t=>!['skipped','failed'].includes(t.result||'')).sort((a,b)=>new Date(a.time||a.date)-new Date(b.time||b.date));
  if(sorted.length < 2){
    ctx.fillStyle='rgba(139,144,160,0.3)'; ctx.font='12px monospace'; ctx.textAlign='center';
    ctx.fillText('No closed trades yet',canvas.width/2,75); return;
  }
  let cum=0;
  const points=[{x:0,y:0}];
  sorted.forEach((t,i)=>{cum+=pnlFn(t);points.push({x:i+1,y:cum});});
  const maxY=Math.max(...points.map(p=>p.y),1);
  const minY=Math.min(...points.map(p=>p.y),-1);
  const rangeY=maxY-minY||1;
  const pad=20; const w=canvas.width-pad*2; const h=canvas.height-pad*2;
  const toX=i=>pad+(i/(points.length-1))*w;
  const toY=v=>pad+h-((v-minY)/rangeY)*h;
  ctx.strokeStyle='rgba(255,255,255,0.08)'; ctx.lineWidth=1; ctx.setLineDash([4,4]);
  ctx.beginPath(); ctx.moveTo(pad,toY(0)); ctx.lineTo(pad+w,toY(0)); ctx.stroke();
  ctx.setLineDash([]);
  const grad=ctx.createLinearGradient(0,pad,0,pad+h);
  grad.addColorStop(0,lineColor+'55'); grad.addColorStop(1,lineColor+'00');
  ctx.beginPath(); ctx.moveTo(toX(0),toY(0));
  points.forEach((p,i)=>ctx.lineTo(toX(i),toY(p.y)));
  ctx.lineTo(toX(points.length-1),toY(0)); ctx.closePath();
  ctx.fillStyle=grad; ctx.fill();
  ctx.beginPath(); ctx.strokeStyle=lineColor; ctx.lineWidth=2; ctx.lineJoin='round';
  points.forEach((p,i)=>i===0?ctx.moveTo(toX(i),toY(p.y)):ctx.lineTo(toX(i),toY(p.y)));
  ctx.stroke();
  points.forEach((p,i)=>{
    ctx.beginPath(); ctx.arc(toX(i),toY(p.y),2.5,0,Math.PI*2);
    ctx.fillStyle=p.y>=0?lineColor:'#ff4f6a'; ctx.fill();
  });
}

function showNotif(msg){
  const el=document.getElementById('notif');
  el.textContent=msg; el.classList.add('show');
  setTimeout(()=>el.classList.remove('show'),2500);
}

// ══════════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  // restore saved theme
  try {
    const saved = localStorage.getItem('tl-theme');
    const btn = document.getElementById('theme-btn');
    if (saved === 'light') {
      document.documentElement.setAttribute('data-theme','light');
      if (btn) { btn.textContent='🌙'; btn.title='Switch to dark theme'; }
    } else {
      if (btn) { btn.textContent='☀'; btn.title='Switch to light theme'; }
    }
  } catch(e){}
  loadAll();
  setInterval(loadAll, 300000); // auto-refresh every 5 min
});
</script>
