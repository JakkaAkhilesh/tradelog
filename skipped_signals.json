<title>TradeLog — Trading Journal</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#0a0c0f; --bg2:#111318; --bg3:#181c22; --bg4:#1e2330;
  --border:rgba(255,255,255,0.07); --border2:rgba(255,255,255,0.12);
  --text:#e8eaf0; --text2:#8b90a0; --text3:#555a6a;
  --accent:#4fffb0; --accent2:#00d4ff; --red:#ff4f6a;
  --amber:#ffb830; --green:#4fffb0; --purple:#a78bfa;
  --font-head:'Syne',sans-serif; --font-mono:'DM Mono',monospace;
}
:root[data-theme="light"] {
  --bg:#f4f6fa; --bg2:#ffffff; --bg3:#e8ecf4; --bg4:#dde2ee;
  --border:rgba(0,0,0,0.08); --border2:rgba(0,0,0,0.14);
  --text:#1a1d26; --text2:#4a5068; --text3:#8a90a4;
  --accent:#00a86b; --accent2:#0088cc; --red:#d93025;
  --amber:#c97a00; --green:#00a86b; --purple:#6b4fc8;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:var(--font-mono);min-height:100vh;overflow-x:hidden;transition:background 0.3s,color 0.3s;}

/* ── TOP BAR ── */
.topbar{position:sticky;top:0;z-index:100;background:rgba(10,12,15,0.95);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:56px;gap:16px;}
.logo{font-family:var(--font-head);font-size:17px;font-weight:800;letter-spacing:-0.5px;flex-shrink:0;}
.logo span{color:var(--accent);}

/* ── MARKET SWITCHER (INDIA / FOREX) ── */
.market-switcher{display:flex;gap:2px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:3px;}
.market-btn{padding:5px 18px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:none;background:transparent;color:var(--text2);font-family:var(--font-mono);transition:all 0.2s;letter-spacing:0.5px;}
.market-btn.active{background:var(--bg4);color:var(--text);}
.market-btn.active.india{color:#ff9f43;}
.market-btn.active.forex{color:var(--accent2);}

/* ── SECTION NAV TABS ── */
.nav-tabs{display:flex;gap:4px;}
.nav-tab{padding:5px 14px;border-radius:6px;font-size:11px;font-weight:500;cursor:pointer;border:none;background:transparent;color:var(--text2);font-family:var(--font-mono);transition:all 0.2s;letter-spacing:0.5px;}
.nav-tab:hover{color:var(--text);background:var(--bg3);}
.nav-tab.active{background:var(--bg4);color:var(--accent);}

/* ── RIGHT CONTROLS ── */
.topbar-right{display:flex;align-items:center;gap:10px;flex-shrink:0;}
.mode-toggle{display:flex;gap:2px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:3px;}
.mode-btn{padding:4px 12px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;border:none;background:transparent;color:var(--text3);font-family:var(--font-mono);letter-spacing:1px;text-transform:uppercase;transition:all 0.2s;}
.mode-btn.active.live{background:rgba(79,255,176,0.12);color:var(--accent);}
.mode-btn.active.paper{background:rgba(255,184,48,0.12);color:var(--amber);}
.mode-btn.active.all{background:var(--bg4);color:var(--text2);}
.refresh-btn{padding:5px 12px;border-radius:6px;font-size:11px;cursor:pointer;border:1px solid var(--border2);background:transparent;color:var(--text2);font-family:var(--font-mono);transition:all 0.2s;}
.refresh-btn:hover{color:var(--text);border-color:var(--accent);}

/* ── MARKET SECTIONS ── */
.market-section{display:none;}
.market-section.active{display:block;}

/* ── PAGES ── */
.page{display:none;padding:28px 24px;max-width:1400px;margin:0 auto;}
.page.active{display:block;}

/* ── STAT CARDS ── */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:28px;}
.stat-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:18px 22px;position:relative;overflow:hidden;}
.stat-card::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent-color,var(--accent)),transparent);opacity:0.6;}
.stat-card.red{--accent-color:var(--red);}
.stat-card.amber{--accent-color:var(--amber);}
.stat-card.purple{--accent-color:var(--purple);}
.stat-card.blue{--accent-color:var(--accent2);}
.stat-label{font-size:10px;color:var(--text3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px;}
.stat-value{font-family:var(--font-head);font-size:26px;font-weight:700;line-height:1;}
.stat-value.green{color:var(--green);}
.stat-value.red{color:var(--red);}
.stat-value.amber{color:var(--amber);}
.stat-value.neutral{color:var(--text);}
.stat-sub{font-size:10px;color:var(--text3);margin-top:6px;}

.section-title{font-family:var(--font-head);font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--text3);margin-bottom:14px;}
.charts-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:28px;}
.chart-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:18px;}
.chart-title{font-size:11px;color:var(--text2);margin-bottom:14px;letter-spacing:0.5px;}
.wr-container{display:flex;align-items:center;justify-content:center;padding:8px 0;}
.wr-circle{position:relative;width:100px;height:100px;}
.wr-circle svg{transform:rotate(-90deg);}
.wr-circle .wr-text{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.wr-pct{font-family:var(--font-head);font-size:22px;font-weight:700;color:var(--accent);}
.wr-label2{font-size:9px;color:var(--text3);letter-spacing:1px;}
.strat-bar-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.strat-name-label{font-size:11px;color:var(--text2);width:90px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.strat-bar-bg{flex:1;height:6px;background:var(--bg4);border-radius:3px;overflow:hidden;}
.strat-bar-fill{height:100%;border-radius:3px;transition:width 0.8s ease;}
.strat-pct-label{font-size:11px;color:var(--text3);width:32px;text-align:right;}
.pnl-bar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.pnl-day-label{font-size:10px;color:var(--text3);width:28px;}
.pnl-bar-wrap{flex:1;display:flex;align-items:center;height:16px;}
.pnl-bar-pos{height:10px;border-radius:2px;background:var(--green);opacity:0.7;}
.pnl-bar-neg{height:10px;border-radius:2px;background:var(--red);opacity:0.7;}
.pnl-val{font-size:10px;color:var(--text2);width:60px;text-align:right;}

/* ── TABLES ── */
.trades-table{width:100%;border-collapse:collapse;}
.trades-table th{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--text3);padding:8px 10px;text-align:left;border-bottom:1px solid var(--border);font-weight:500;}
.trades-table td{padding:9px 10px;font-size:12px;border-bottom:1px solid var(--border);}
.trades-table tr:last-child td{border-bottom:none;}
.trades-table tr:hover td{background:rgba(255,255,255,0.02);}
.result-badge{padding:3px 10px;border-radius:20px;font-size:10px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;}
.result-badge.target{background:rgba(79,255,176,0.12);color:var(--green);border:1px solid rgba(79,255,176,0.2);}
.result-badge.sl{background:rgba(255,79,106,0.12);color:var(--red);border:1px solid rgba(255,79,106,0.2);}
.result-badge.be{background:rgba(139,144,160,0.1);color:var(--text2);border:1px solid rgba(139,144,160,0.15);}
.result-badge.open,.result-badge.pending{background:rgba(0,212,255,0.08);color:var(--accent2);border:1px solid rgba(0,212,255,0.15);}
.result-badge.skipped{background:rgba(255,184,48,0.1);color:var(--amber);border:1px solid rgba(255,184,48,0.2);}
.result-badge.failed{background:rgba(167,139,250,0.1);color:var(--purple);border:1px solid rgba(167,139,250,0.2);}
.result-badge.entered{background:rgba(79,255,176,0.08);color:var(--green);border:1px solid rgba(79,255,176,0.15);}
.trades-container{background:var(--bg2);border:1px solid var(--border);border-radius:12px;overflow:hidden;}
.empty-state{text-align:center;padding:60px 20px;color:var(--text3);}
.empty-icon{font-size:40px;margin-bottom:12px;opacity:0.4;}
.empty-text{font-size:13px;}
.filters-row{display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center;}
.filter-select{background:var(--bg2);border:1px solid var(--border2);border-radius:7px;color:var(--text);font-family:var(--font-mono);font-size:11px;padding:7px 12px;outline:none;cursor:pointer;}
.trades-count{font-size:11px;color:var(--text3);margin-left:auto;}

/* ── ANALYTICS ── */
.analytics-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px;}
.analytics-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:20px;}
.analytics-card.full{grid-column:1/-1;}
.equity-canvas-wrap{position:relative;height:160px;}
.perf-summary-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}

/* ── FOREX SIGNAL BADGES ── */
.dir-badge{padding:3px 9px;border-radius:4px;font-size:10px;font-weight:600;}
.dir-badge.buy{background:rgba(79,255,176,0.1);color:var(--green);}
.dir-badge.sell{background:rgba(255,79,106,0.1);color:var(--red);}
.sym-badge{padding:2px 7px;border-radius:4px;font-size:10px;background:rgba(0,212,255,0.08);color:var(--accent2);}

/* ── MISC ── */
.compress-bar{display:flex;align-items:center;gap:6px;}
.compress-fill{height:6px;border-radius:3px;background:var(--red);}
.compress-bg{flex:1;height:6px;background:var(--bg4);border-radius:3px;overflow:hidden;min-width:60px;}
::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:3px;}
.notif{position:fixed;bottom:24px;right:24px;z-index:999;background:var(--bg3);border:1px solid var(--accent);border-radius:10px;padding:12px 20px;font-size:13px;color:var(--accent);transform:translateY(80px);opacity:0;transition:all 0.3s;}
.notif.show{transform:translateY(0);opacity:1;}
.last-updated{font-size:10px;color:var(--text3);}
.section-divider{height:1px;background:var(--border);margin:0 0 20px 0;}

@media(max-width:900px){
  .stats-grid{grid-template-columns:1fr 1fr;}
  .charts-row{grid-template-columns:1fr;}
  .analytics-grid{grid-template-columns:1fr;}
  .perf-summary-grid{grid-template-columns:repeat(2,1fr);}
}
@media(max-width:600px){
  .topbar{flex-wrap:wrap;height:auto;padding:10px 16px;gap:8px;}
  .page{padding:16px;}
  .stats-grid{grid-template-columns:1fr 1fr;}
}
</style>

<!-- ══════════════════════════════════════════════════════════
     TOP BAR
════════════════════════════════════════════════════════════ -->
<div class="topbar">
  <div class="logo">Trade<span>Log</span></div>

  <div class="market-switcher">
    <button class="market-btn active india" onclick="switchMarket('india')">🇮🇳 INDIA</button>
    <button class="market-btn forex" onclick="switchMarket('forex')">💱 FOREX</button>
  </div>

  <!-- INDIA nav -->
  <div class="nav-tabs" id="india-nav">
    <button class="nav-tab active" onclick="showPage('india','dashboard')">Dashboard</button>
    <button class="nav-tab" onclick="showPage('india','trades')">Trades</button>
    <button class="nav-tab" onclick="showPage('india','skipped')">Skipped</button>
    <button class="nav-tab" onclick="showPage('india','analytics')">Analytics</button>
  </div>

  <!-- FOREX nav -->
  <div class="nav-tabs" id="forex-nav" style="display:none">
    <button class="nav-tab active" onclick="showPage('forex','dashboard')">Dashboard</button>
    <button class="nav-tab" onclick="showPage('forex','signals')">Signals</button>
    <button class="nav-tab" onclick="showPage('forex','analytics')">Analytics</button>
  </div>

  <div class="topbar-right">
    <div class="mode-toggle" id="mode-toggle">
      <button class="mode-btn active all" onclick="setMode('all')">ALL</button>
      <button class="mode-btn live" onclick="setMode('live')">LIVE</button>
      <button class="mode-btn paper" onclick="setMode('paper')">PAPER</button>
    </div>
    <span class="last-updated" id="last-updated">—</span>
    <button class="refresh-btn" id="theme-btn" onclick="toggleTheme()" title="Toggle theme">☀</button>
    <button class="refresh-btn" onclick="loadAll()">↺ Refresh</button>
  </div>
</div>

<div id="notif" class="notif"></div>

<!-- ══════════════════════════════════════════════════════════
     INDIA SECTION
════════════════════════════════════════════════════════════ -->
<div class="market-section active" id="section-india">

  <!-- INDIA DASHBOARD -->
  <div class="page active" id="india-page-dashboard">
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total P&amp;L</div>
        <div class="stat-value green" id="i-stat-pnl">—</div>
        <div class="stat-sub" id="i-stat-pnl-pts">— points</div>
      </div>
      <div class="stat-card amber">
        <div class="stat-label">Win Rate</div>
        <div class="stat-value amber" id="i-stat-wr">—%</div>
        <div class="stat-sub" id="i-stat-wr-sub">— closed</div>
      </div>
      <div class="stat-card blue">
        <div class="stat-label">Today</div>
        <div class="stat-value neutral" id="i-stat-today">—</div>
        <div class="stat-sub" id="i-stat-today-pnl">P&L: —</div>
      </div>
      <div class="stat-card purple">
        <div class="stat-label">Skipped</div>
        <div class="stat-value neutral" id="i-stat-skipped">—</div>
        <div class="stat-sub" id="i-stat-skip-reason">—</div>
      </div>
    </div>
    <div class="section-title">Overview</div>
    <div class="charts-row">
      <div class="chart-card">
        <div class="chart-title">Win Rate</div>
        <div class="wr-container">
          <div class="wr-circle">
            <svg width="100" height="100" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="40" fill="none" stroke="var(--bg4)" stroke-width="8"/>
              <circle cx="50" cy="50" r="40" fill="none" stroke="var(--accent)" stroke-width="8"
                stroke-dasharray="251.2" id="i-wr-circle-fill" stroke-dashoffset="251.2" stroke-linecap="round"/>
            </svg>
            <div class="wr-text">
              <span class="wr-pct" id="i-wr-pct-text">—%</span>
              <span class="wr-label2">WIN RATE</span>
            </div>
          </div>
        </div>
        <div style="display:flex;justify-content:center;gap:16px;margin-top:8px;">
          <span style="font-size:11px;color:var(--green)">W: <strong id="i-wr-wins">0</strong></span>
          <span style="font-size:11px;color:var(--red)">L: <strong id="i-wr-losses">0</strong></span>
          <span style="font-size:11px;color:var(--text2)">BE: <strong id="i-wr-be">0</strong></span>
        </div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Strategy Win Rates</div>
        <div id="i-strat-bars"></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">7-Day P&amp;L</div>
        <div id="i-pnl-bars"></div>
      </div>
    </div>
    <div class="section-title">Recent Trades</div>
    <div class="trades-container">
      <table class="trades-table">
        <thead><tr>
          <th>Date</th><th>Strategy</th><th>Dir</th><th>Entry</th><th>SL</th><th>Target</th><th>R:R</th><th>Exit</th><th>Points</th><th>P&amp;L</th><th>Result</th><th>Mode</th>
        </tr></thead>
        <tbody id="i-recent-tbody"></tbody>
      </table>
      <div class="empty-state" id="i-recent-empty" style="display:none"><div class="empty-icon">📊</div><div class="empty-text">No trades yet</div></div>
    </div>
  </div>

  <!-- INDIA TRADES -->
  <div class="page" id="india-page-trades">
    <div class="filters-row">
      <select class="filter-select" id="i-filter-strategy" onchange="renderIndiaTrades()"><option value="">All Strategies</option></select>
      <select class="filter-select" id="i-filter-result" onchange="renderIndiaTrades()">
        <option value="">All Results</option><option value="target">Target</option><option value="sl">SL</option><option value="be">BE</option><option value="open">Open</option>
      </select>
      <select class="filter-select" id="i-filter-dir" onchange="renderIndiaTrades()">
        <option value="">Both Dirs</option><option value="BUY">BUY</option><option value="SELL">SELL</option>
      </select>
      <span class="trades-count" id="i-trades-count">—</span>
    </div>
    <div class="trades-container">
      <table class="trades-table">
        <thead><tr>
          <th>#</th><th>Date</th><th>Time</th><th>Strategy</th><th>Dir</th><th>Symbol</th><th>Entry</th><th>SL</th><th>Target</th><th>R:R</th><th>Exit</th><th>Points</th><th>P&amp;L</th><th>ADX</th><th>VIX</th><th>Result</th><th>Mode</th>
        </tr></thead>
        <tbody id="i-all-tbody"></tbody>
      </table>
      <div class="empty-state" id="i-all-empty" style="display:none"><div class="empty-icon">📋</div><div class="empty-text">No trades match</div></div>
    </div>
  </div>

  <!-- INDIA SKIPPED -->
  <div class="page" id="india-page-skipped">
    <div style="display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap;">
      <div class="stat-card" style="flex:1;min-width:120px;padding:14px 18px;">
        <div class="stat-label">Total Skipped</div>
        <div class="stat-value neutral" id="i-skipped-count">—</div>
      </div>
      <div class="stat-card amber" style="flex:1;min-width:120px;padding:14px 18px;">
        <div class="stat-label">Compression</div>
        <div class="stat-value amber" id="i-skip-compress-count">—</div>
      </div>
      <div class="stat-card red" style="flex:1;min-width:120px;padding:14px 18px;">
        <div class="stat-label">ADX High</div>
        <div class="stat-value red" id="i-skip-adx-count">—</div>
      </div>
      <div class="stat-card blue" style="flex:1;min-width:120px;padding:14px 18px;">
        <div class="stat-label">ADX Low</div>
        <div class="stat-value neutral" id="i-skip-adxlow-count">—</div>
      </div>
      <div class="stat-card purple" style="flex:1;min-width:120px;padding:14px 18px;">
        <div class="stat-label">VIX</div>
        <div class="stat-value neutral" id="i-skip-other-count">—</div>
      </div>
    </div>
    <div class="filters-row">
      <select class="filter-select" id="i-skip-filter-strategy" onchange="renderIndiaSkipped()"><option value="">All Strategies</option></select>
      <select class="filter-select" id="i-skip-filter-reason" onchange="renderIndiaSkipped()">
        <option value="">All Reasons</option><option value="compression">Compression</option><option value="adx">ADX</option><option value="vix">VIX</option>
      </select>
      <select class="filter-select" id="i-skip-filter-dir" onchange="renderIndiaSkipped()">
        <option value="">Both Dirs</option><option value="BUY">BUY</option><option value="SELL">SELL</option>
      </select>
    </div>
    <div class="trades-container">
      <table class="trades-table">
        <thead><tr>
          <th>#</th><th>Date</th><th>Time</th><th>Strategy</th><th>Dir</th><th>Price</th><th>Reason</th><th>Orig SL</th><th>Budget SL</th><th>Compress</th><th>ADX</th><th>VIX</th>
        </tr></thead>
        <tbody id="i-skip-tbody"></tbody>
      </table>
      <div class="empty-state" id="i-skip-empty" style="display:none"><div class="empty-icon">⏭</div><div class="empty-text">No skipped signals</div></div>
    </div>
  </div>

  <!-- INDIA ANALYTICS -->
  <div class="page" id="india-page-analytics">
    <div class="analytics-grid">
      <div class="analytics-card full">
        <div class="chart-title">Equity Curve</div>
        <div class="equity-canvas-wrap"><canvas id="i-equityCanvas"></canvas></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Results Breakdown</div>
        <div id="i-results-breakdown"></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Strategy Win Rate</div>
        <div id="i-strat-wr-breakdown"></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Skip Reasons</div>
        <div id="i-skip-breakdown"></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Performance</div>
        <div class="perf-summary-grid" id="i-perf-summary"></div>
      </div>
    </div>
  </div>

</div><!-- /section-india -->

<!-- ══════════════════════════════════════════════════════════
     FOREX SECTION
════════════════════════════════════════════════════════════ -->
<div class="market-section" id="section-forex">

  <!-- FOREX DASHBOARD -->
  <div class="page active" id="forex-page-dashboard">
    <div class="stats-grid">
      <div class="stat-card blue">
        <div class="stat-label">Total Signals</div>
        <div class="stat-value neutral" id="f-stat-total">—</div>
        <div class="stat-sub" id="f-stat-total-sub">—</div>
      </div>
      <div class="stat-card amber">
        <div class="stat-label">Win Rate</div>
        <div class="stat-value amber" id="f-stat-wr">—%</div>
        <div class="stat-sub" id="f-stat-wr-sub">— closed</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">W / L / Pending</div>
        <div class="stat-value" id="f-stat-wlp" style="font-size:18px;letter-spacing:1px">— / — / —</div>
        <div class="stat-sub" id="f-stat-wlp-sub">entered signals</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total P&amp;L (USD)</div>
        <div class="stat-value green" id="f-stat-pnl">—</div>
        <div class="stat-sub" id="f-stat-pnl-sub">—</div>
      </div>
      <div class="stat-card purple">
        <div class="stat-label">Pending / Skipped</div>
        <div class="stat-value neutral" id="f-stat-open">—</div>
        <div class="stat-sub" id="f-stat-open-sub">—</div>
      </div>
    </div>

    <div class="section-title">Overview</div>
    <div class="charts-row">
      <div class="chart-card">
        <div class="chart-title">Win Rate</div>
        <div class="wr-container">
          <div class="wr-circle">
            <svg width="100" height="100" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="40" fill="none" stroke="var(--bg4)" stroke-width="8"/>
              <circle cx="50" cy="50" r="40" fill="none" stroke="var(--accent2)" stroke-width="8"
                stroke-dasharray="251.2" id="f-wr-circle-fill" stroke-dashoffset="251.2" stroke-linecap="round"/>
            </svg>
            <div class="wr-text">
              <span class="wr-pct" id="f-wr-pct-text" style="color:var(--accent2)">—%</span>
              <span class="wr-label2">WIN RATE</span>
            </div>
          </div>
        </div>
        <div style="display:flex;justify-content:center;gap:16px;margin-top:8px;">
          <span style="font-size:11px;color:var(--green)">W: <strong id="f-wr-wins">0</strong></span>
          <span style="font-size:11px;color:var(--red)">L: <strong id="f-wr-losses">0</strong></span>
          <span style="font-size:11px;color:var(--text2)">P: <strong id="f-wr-pending">0</strong></span>
        </div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Strategy Breakdown</div>
        <div id="f-strat-bars"></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Symbol Split</div>
        <div id="f-symbol-bars"></div>
      </div>
    </div>

    <div class="section-title">Recent Signals</div>
    <div class="trades-container">
      <table class="trades-table">
        <thead><tr>
          <th>Time</th><th>Strategy</th><th>Symbol</th><th>Dir</th><th>TF</th><th>Entry</th><th>SL</th><th>TP1</th><th>Lot</th><th>Risk $</th><th>Outcome</th><th>Status</th><th>Mode</th>
        </tr></thead>
        <tbody id="f-recent-tbody"></tbody>
      </table>
      <div class="empty-state" id="f-recent-empty" style="display:none"><div class="empty-icon">📡</div><div class="empty-text">No signals yet</div></div>
    </div>
  </div>

  <!-- FOREX SIGNALS -->
  <div class="page" id="forex-page-signals">
    <div class="filters-row">
      <select class="filter-select" id="f-filter-symbol" onchange="renderForexSignals()"><option value="">All Symbols</option></select>
      <select class="filter-select" id="f-filter-strategy" onchange="renderForexSignals()"><option value="">All Strategies</option></select>
      <select class="filter-select" id="f-filter-dir" onchange="renderForexSignals()">
        <option value="">Both Dirs</option><option value="BUY">BUY</option><option value="SELL">SELL</option>
      </select>
      <select class="filter-select" id="f-filter-decision" onchange="renderForexSignals()">
        <option value="">All Status</option><option value="pending">Pending</option><option value="entered">Entered</option><option value="skipped">Skipped</option>
      </select>
      <span class="trades-count" id="f-signals-count">—</span>
    </div>
    <div class="trades-container">
      <table class="trades-table">
        <thead><tr>
          <th>#</th><th>Time</th><th>Strategy</th><th>Symbol</th><th>Dir</th><th>TF</th><th>Entry</th><th>SL</th><th>TP1</th><th>TP Max</th><th>Lot</th><th>Risk $</th><th>Outcome</th><th>Status</th><th>Mode</th>
        </tr></thead>
        <tbody id="f-all-tbody"></tbody>
      </table>
      <div class="empty-state" id="f-all-empty" style="display:none"><div class="empty-icon">📋</div><div class="empty-text">No signals match</div></div>
    </div>
  </div>

  <!-- FOREX ANALYTICS -->
  <div class="page" id="forex-page-analytics">
    <div class="analytics-grid">
      <div class="analytics-card full">
        <div class="chart-title">P&amp;L Curve (USD)</div>
        <div class="equity-canvas-wrap"><canvas id="f-equityCanvas"></canvas></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Results Breakdown</div>
        <div id="f-results-breakdown"></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Strategy Breakdown</div>
        <div id="f-strat-wr-breakdown"></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Symbol Performance</div>
        <div id="f-symbol-breakdown"></div>
      </div>
      <div class="analytics-card">
        <div class="chart-title">Performance</div>
        <div class="perf-summary-grid" id="f-perf-summary"></div>
      </div>
    </div>
  </div>

</div><!-- /section-forex -->

<script>
// ══════════════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════════════
let currentMarket = 'india';
let currentMode   = 'all'; // 'all' | 'live' | 'paper'

// INDIA data
let indiaTrades  = [];
let indiaSkipped = [];

// FOREX data
let forexSignals = [];

// GitHub raw URLs
const INDIA_TRADES_URL   = 'https://raw.githubusercontent.com/JakkaAkhilesh/tradelog/main/trades.json';
const INDIA_SKIPPED_URL  = 'https://raw.githubusercontent.com/JakkaAkhilesh/tradelog/main/skipped_signals.json';
const INDIA_CAPITAL_URL  = 'https://raw.githubusercontent.com/JakkaAkhilesh/tradelog/main/paper_capital.json';
const FOREX_SIGNALS_URL  = 'https://raw.githubusercontent.com/JakkaAkhilesh/forexlog/main/signals.json';

// ══════════════════════════════════════════════════════════
// MARKET SWITCH
// ══════════════════════════════════════════════════════════
function switchMarket(market) {
  currentMarket = market;
  document.querySelectorAll('.market-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('.market-btn.' + market).classList.add('active');
  document.getElementById('india-nav').style.display  = market === 'india' ? 'flex' : 'none';
  document.getElementById('forex-nav').style.display  = market === 'forex' ? 'flex' : 'none';
  document.getElementById('section-india').classList.toggle('active', market === 'india');
  document.getElementById('section-forex').classList.toggle('active', market === 'forex');
  if (market === 'india')  renderIndiaPage();
  if (market === 'forex')  renderForexPage();
}

// ══════════════════════════════════════════════════════════
// MODE TOGGLE
// ══════════════════════════════════════════════════════════
function setMode(mode) {
  currentMode = mode;
  document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('.mode-btn.' + mode).classList.add('active');
  if (currentMarket === 'india') renderIndiaPage();
  else renderForexPage();
}

function toggleTheme() {
  const root = document.documentElement;
  const btn = document.getElementById('theme-btn');
  const isLight = root.getAttribute('data-theme') === 'light';
  if (isLight) {
    root.removeAttribute('data-theme');
    btn.textContent = '☀';
    btn.title = 'Switch to light theme';
    try { localStorage.setItem('tl-theme','dark'); } catch(e){}
  } else {
    root.setAttribute('data-theme','light');
    btn.textContent = '🌙';
    btn.title = 'Switch to dark theme';
    try { localStorage.setItem('tl-theme','light'); } catch(e){}
  }
}

function filterByMode(list, modeField='mode') {
  if (currentMode === 'all') return list;
  return list.filter(t => (t[modeField]||'paper').toLowerCase() === currentMode);
}

// ══════════════════════════════════════════════════════════
// DATA LOAD
// ══════════════════════════════════════════════════════════
async function loadAll() {
  document.getElementById('last-updated').textContent = 'Loading…';
  await Promise.all([loadIndiaData(), loadForexData()]);
  const now = new Date();
  document.getElementById('last-updated').textContent =
    'Updated ' + now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
  if (currentMarket === 'india') renderIndiaPage();
  else renderForexPage();
}

async function loadIndiaData() {
  try {
    const [tr, sk] = await Promise.all([
      fetch(INDIA_TRADES_URL  + '?t=' + Date.now()).then(r => r.ok ? r.json() : []),
      fetch(INDIA_SKIPPED_URL + '?t=' + Date.now()).then(r => r.ok ? r.json() : []),
    ]);
    indiaTrades  = Array.isArray(tr) ? tr : [];
    indiaSkipped = Array.isArray(sk) ? sk : [];
    // Capital
    try {
      const cap = await fetch(INDIA_CAPITAL_URL + '?t=' + Date.now());
      if (cap.ok) {
        const c = await cap.json();
        const cur = c.current_capital || 50000;
        const start = c.starting_capital || 50000;
        const pnl = cur - start;
        document.getElementById('i-stat-pnl').textContent =
          (pnl >= 0 ? 'Rs.' : '-Rs.') + Math.abs(Math.round(pnl)).toLocaleString('en-IN');
      }
    } catch(e) {}
    // Populate strategy dropdowns
    const strats = [...new Set(indiaTrades.map(t => t.strategy).filter(Boolean))];
    ['i-filter-strategy','i-skip-filter-strategy'].forEach(id => {
      const sel = document.getElementById(id);
      const cur = sel.value;
      sel.innerHTML = '<option value="">All Strategies</option>' +
        strats.map(s => `<option value="${s}"${s===cur?' selected':''}>${s}</option>`).join('');
    });
  } catch(e) { console.error('India load error', e); }
}

async function loadForexData() {
  try {
    const data = await fetch(FOREX_SIGNALS_URL + '?t=' + Date.now()).then(r => r.ok ? r.json() : []);
    forexSignals = Array.isArray(data) ? data : [];
    // Populate dropdowns
    const strats  = [...new Set(forexSignals.map(s => s.strategy).filter(Boolean))];
    const symbols = [...new Set(forexSignals.map(s => s.symbol).filter(Boolean))];
    const stratSel = document.getElementById('f-filter-strategy');
    stratSel.innerHTML = '<option value="">All Strategies</option>' +
      strats.map(s => `<option value="${s}">${s}</option>`).join('');
    const symSel = document.getElementById('f-filter-symbol');
    symSel.innerHTML = '<option value="">All Symbols</option>' +
      symbols.map(s => `<option value="${s}">${s}</option>`).join('');
  } catch(e) { console.error('Forex load error', e); }
}

// ══════════════════════════════════════════════════════════
// PAGE NAVIGATION
// ══════════════════════════════════════════════════════════
function showPage(market, pageId) {
  const prefix = market === 'india' ? 'india' : 'forex';
  document.querySelectorAll(`#section-${market} .page`).forEach(p => p.classList.remove('active'));
  document.getElementById(`${prefix}-page-${pageId}`).classList.add('active');
  const nav = document.getElementById(`${market}-nav`);
  nav.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  const tabs = nav.querySelectorAll('.nav-tab');
  const indiaMap   = {dashboard:0, trades:1, skipped:2, analytics:3};
  const forexMap   = {dashboard:0, signals:1, analytics:2};
  const map = market === 'india' ? indiaMap : forexMap;
  if (tabs[map[pageId]]) tabs[map[pageId]].classList.add('active');
  if (market === 'india') {
    if (pageId === 'dashboard')  renderIndiaDashboard();
    if (pageId === 'trades')     renderIndiaTrades();
    if (pageId === 'skipped')    renderIndiaSkipped();
    if (pageId === 'analytics')  renderIndiaAnalytics();
  } else {
    if (pageId === 'dashboard')  renderForexDashboard();
    if (pageId === 'signals')    renderForexSignals();
    if (pageId === 'analytics')  renderForexAnalytics();
  }
}

function renderIndiaPage() {
  const active = document.querySelector('#section-india .page.active');
  const id = active ? active.id.replace('india-page-','') : 'dashboard';
  if (id==='dashboard')  renderIndiaDashboard();
  if (id==='trades')     renderIndiaTrades();
  if (id==='skipped')    renderIndiaSkipped();
  if (id==='analytics')  renderIndiaAnalytics();
}
function renderForexPage() {
  const active = document.querySelector('#section-forex .page.active');
  const id = active ? active.id.replace('forex-page-','') : 'dashboard';
  if (id==='dashboard')  renderForexDashboard();
  if (id==='signals')    renderForexSignals();
  if (id==='analytics')  renderForexAnalytics();
}

// ══════════════════════════════════════════════════════════
// INDIA RENDER
// ══════════════════════════════════════════════════════════
function renderIndiaDashboard() {
  const ft = filterByMode(indiaTrades);
  const closed = ft.filter(t => t.result && !['open','skipped','failed'].includes(t.result));
  const wins = closed.filter(t => t.result === 'target');
  const losses = closed.filter(t => t.result === 'sl');
  const bes = closed.filter(t => t.result === 'be');
  const totalPnl = ft.reduce((s,t) => s+(t.pnl||0), 0);
  const wr = closed.length ? ((wins.length/closed.length)*100).toFixed(1) : 0;
  const totalPts = ft.reduce((s,t) => s+(t.points||0), 0);
  const today = new Date().toISOString().split('T')[0];
  const todayTrades = ft.filter(t => t.date === today);
  const todayPnl = todayTrades.reduce((s,t) => s+(t.pnl||0), 0);
  const todaySkips = indiaSkipped.filter(s => (s.date||'').startsWith(today));

  document.getElementById('i-stat-pnl').textContent = (totalPnl>=0?'Rs.':'-Rs.')+Math.abs(Math.round(totalPnl)).toLocaleString('en-IN');
  document.getElementById('i-stat-pnl').className = 'stat-value '+(totalPnl>=0?'green':'red');
  document.getElementById('i-stat-pnl-pts').textContent = (totalPts>=0?'+':'')+totalPts.toFixed(1)+' points';
  document.getElementById('i-stat-wr').textContent = wr+'%';
  document.getElementById('i-stat-wr-sub').textContent = closed.length+' closed';
  document.getElementById('i-stat-today').textContent = todayTrades.length;
  document.getElementById('i-stat-today-pnl').textContent = 'P&L: '+(todayPnl>=0?'Rs.':'-Rs.')+Math.abs(Math.round(todayPnl));
  document.getElementById('i-stat-skipped').textContent = filterByMode(indiaSkipped).length;
  document.getElementById('i-stat-skip-reason').textContent = todaySkips.length+' skipped today';

  const circ = 251.2;
  document.getElementById('i-wr-circle-fill').style.strokeDashoffset = circ - (parseFloat(wr)/100)*circ;
  document.getElementById('i-wr-pct-text').textContent = wr+'%';
  document.getElementById('i-wr-wins').textContent = wins.length;
  document.getElementById('i-wr-losses').textContent = losses.length;
  document.getElementById('i-wr-be').textContent = bes.length;

  renderIndiaStratBars(ft);
  renderIndiaPnlBars(ft);

  const tbody = document.getElementById('i-recent-tbody');
  const empty = document.getElementById('i-recent-empty');
  const recent = [...ft].reverse().slice(0,8);
  if (!recent.length) { tbody.innerHTML=''; empty.style.display='block'; return; }
  empty.style.display = 'none';
  tbody.innerHTML = recent.map(t => `<tr>
    <td style="color:var(--text3)">${t.date||'—'}</td>
    <td style="color:var(--accent2)">${t.strategy||'—'}</td>
    <td><span style="color:${t.direction==='BUY'?'var(--green)':'var(--red)'}">${t.direction||'—'}</span></td>
    <td>${t.entry_price||t.entry||'—'}</td>
    <td style="color:var(--red)">${t.sl||'—'}</td>
    <td style="color:var(--green)">${t.target||'—'}</td>
    <td style="color:var(--text2)">${t.rr?'1:'+t.rr:'—'}</td>
    <td>${t.exit_price||t.exit||'—'}</td>
    <td style="color:${(t.points||0)>=0?'var(--green)':'var(--red)'}; font-weight:600">${(t.points||0)>0?'+':''}${(t.points||0).toFixed(1)}</td>
    <td style="color:${(t.pnl||0)>=0?'var(--green)':'var(--red)'}; font-weight:600">${(t.pnl||0)>=0?'Rs.':'-Rs.'}${Math.abs(Math.round(t.pnl||0))}</td>
    <td><span class="result-badge ${(t.result||'open').toLowerCase()}">${t.result||'open'}</span></td>
    <td><span style="padding:2px 7px;border-radius:4px;font-size:10px;background:${(t.mode||'paper')==='live'?'rgba(79,255,176,0.1)':'rgba(255,184,48,0.1)'};color:${(t.mode||'paper')==='live'?'var(--accent)':'var(--amber)'};">${(t.mode||'paper').toUpperCase()}</span></td>
  </tr>`).join('');
}

function renderIndiaStratBars(ft) {
  ft = ft || filterByMode(indiaTrades);
  const stratMap = {};
  ft.filter(t=>t.result&&t.result!=='open').forEach(t=>{
    if(!stratMap[t.strategy]) stratMap[t.strategy]={w:0,total:0};
    stratMap[t.strategy].total++;
    if(t.result==='target') stratMap[t.strategy].w++;
  });
  const container = document.getElementById('i-strat-bars');
  const entries = Object.entries(stratMap).sort((a,b)=>(b[1].w/b[1].total)-(a[1].w/a[1].total)).slice(0,5);
  if(!entries.length){container.innerHTML='<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">No data</div>';return;}
  const colors=['var(--accent)','var(--accent2)','var(--amber)','var(--purple)','var(--red)'];
  container.innerHTML=entries.map(([name,d],i)=>{
    const wr=((d.w/d.total)*100).toFixed(0);
    return`<div class="strat-bar-row"><div class="strat-name-label" title="${name}">${name}</div><div class="strat-bar-bg"><div class="strat-bar-fill" style="width:${wr}%;background:${colors[i]}"></div></div><div class="strat-pct-label">${wr}%</div></div>`;
  }).join('');
}

function renderIndiaPnlBars(ft) {
  const container = document.getElementById('i-pnl-bars');
  const days={};
  const today=new Date();
  for(let i=6;i>=0;i--){const d=new Date(today);d.setDate(d.getDate()-i);days[d.toISOString().split('T')[0]]=0;}
  (ft||filterByMode(indiaTrades)).forEach(t=>{if(days[t.date]!==undefined)days[t.date]+=(t.pnl||0);});
  const maxAbs=Math.max(...Object.values(days).map(Math.abs),1);
  container.innerHTML=Object.entries(days).map(([date,pnl])=>{
    const label=new Date(date).toLocaleDateString('en-IN',{weekday:'short'}).substring(0,3);
    const barW=Math.max((Math.abs(pnl)/maxAbs)*100,pnl!==0?4:0);
    return`<div class="pnl-bar-row"><div class="pnl-day-label">${label}</div><div class="pnl-bar-wrap"><div class="${pnl>=0?'pnl-bar-pos':'pnl-bar-neg'}" style="width:${barW}%"></div></div><div class="pnl-val" style="color:${pnl>=0?'var(--green)':'var(--red)'}">${pnl>=0?'Rs.':'-Rs.'}${Math.abs(Math.round(pnl))}</div></div>`;
  }).join('');
}

function renderIndiaTrades() {
  const fs=document.getElementById('i-filter-strategy').value;
  const fr=document.getElementById('i-filter-result').value;
  const fd=document.getElementById('i-filter-dir').value;
  let filtered=filterByMode(indiaTrades).filter(t=>(!fs||t.strategy===fs)&&(!fr||(t.result||'').toLowerCase()===fr)&&(!fd||t.direction===fd));
  document.getElementById('i-trades-count').textContent=filtered.length+' trades';
  const tbody=document.getElementById('i-all-tbody');
  const empty=document.getElementById('i-all-empty');
  if(!filtered.length){tbody.innerHTML='';empty.style.display='block';return;}
  empty.style.display='none';
  tbody.innerHTML=filtered.map((t,i)=>`<tr>
    <td style="color:var(--text3)">${i+1}</td>
    <td style="color:var(--text3)">${t.date||'—'}</td>
    <td style="color:var(--text3)">${t.time||'—'}</td>
    <td style="color:var(--accent2)">${t.strategy||'—'}</td>
    <td><span style="color:${t.direction==='BUY'?'var(--green)':'var(--red)'}">${t.direction||'—'}</span></td>
    <td style="font-size:11px">${t.option_symbol||t.strike||'—'}</td>
    <td>${t.entry_price||t.entry||'—'}</td>
    <td style="color:var(--red)">${t.sl||'—'}</td>
    <td style="color:var(--green)">${t.target||'—'}</td>
    <td style="color:var(--text2)">${t.rr?'1:'+t.rr:'—'}</td>
    <td>${t.exit_price||t.exit||'—'}</td>
    <td style="color:${(t.points||0)>=0?'var(--green)':'var(--red)'};font-weight:600">${(t.points||0)>0?'+':''}${(t.points||0).toFixed(1)}</td>
    <td style="color:${(t.pnl||0)>=0?'var(--green)':'var(--red)'};font-weight:600">${(t.pnl||0)>=0?'Rs.':'-Rs.'}${Math.abs(Math.round(t.pnl||0))}</td>
    <td style="color:var(--text2)">${t.adx||'—'}</td>
    <td style="color:var(--text2)">${t.vix_ratio||'—'}</td>
    <td><span class="result-badge ${(t.result||'open').toLowerCase()}">${t.result||'open'}</span></td>
    <td><span style="padding:2px 7px;border-radius:4px;font-size:10px;background:${(t.mode||'paper')==='live'?'rgba(79,255,176,0.1)':'rgba(255,184,48,0.1)'};color:${(t.mode||'paper')==='live'?'var(--accent)':'var(--amber)'};">${(t.mode||'paper').toUpperCase()}</span></td>
  </tr>`).join('');
}

function renderIndiaSkipped() {
  const fs=document.getElementById('i-skip-filter-strategy').value;
  const fr=document.getElementById('i-skip-filter-reason').value;
  const fd=document.getElementById('i-skip-filter-dir').value;
  const modeFiltered=filterByMode(indiaSkipped);
  let filtered=modeFiltered.filter(s=>(!fs||s.strategy===fs)&&(!fr||(s.skip_reason||s.reason||'').includes(fr))&&(!fd||s.direction===fd));
  document.getElementById('i-skipped-count').textContent=modeFiltered.length;
  document.getElementById('i-skip-compress-count').textContent=modeFiltered.filter(s=>(s.skip_reason||'').includes('compression')).length;
  document.getElementById('i-skip-adx-count').textContent=modeFiltered.filter(s=>(s.reason||'').toLowerCase().includes('exhaustion')).length;
  document.getElementById('i-skip-adxlow-count').textContent=modeFiltered.filter(s=>(s.reason||'').toLowerCase().includes('adx')&&!(s.reason||'').toLowerCase().includes('exhaustion')).length;
  document.getElementById('i-skip-other-count').textContent=modeFiltered.filter(s=>(s.reason||'').toLowerCase().includes('vix')).length;
  const tbody=document.getElementById('i-skip-tbody');
  const empty=document.getElementById('i-skip-empty');
  if(!filtered.length){tbody.innerHTML='';empty.style.display='block';return;}
  empty.style.display='none';
  tbody.innerHTML=filtered.map((s,i)=>{
    const reason=s.reason||s.skip_reason||'—';
    const shortReason=reason.length>40?reason.substring(0,40)+'...':reason;
    const compress=s.compression_pct||(s.compression_ratio?Math.round((1-s.compression_ratio)*100):null);
    return`<tr>
      <td style="color:var(--text3)">${i+1}</td>
      <td style="color:var(--text3)">${s.date||'—'}</td>
      <td style="color:var(--text3)">${s.time||'—'}</td>
      <td style="color:var(--accent2)">${s.strategy||'—'}</td>
      <td><span style="color:${s.direction==='BUY'?'var(--green)':'var(--red)'}">${s.direction||'—'}</span></td>
      <td>${s.signal_price||s.price||'—'}</td>
      <td><span style="padding:3px 10px;border-radius:4px;font-size:10px;background:rgba(255,184,48,0.1);color:var(--amber)" title="${reason}">${shortReason}</span></td>
      <td style="color:var(--red)">${s.original_sl_pts?s.original_sl_pts+' pts':'—'}</td>
      <td style="color:var(--amber)">${s.adjusted_sl_pts?s.adjusted_sl_pts+' pts':'—'}</td>
      <td>${compress?`<div class="compress-bar"><div class="compress-bg"><div class="compress-fill" style="width:${Math.min(compress,100)}%"></div></div><span style="font-size:11px;color:var(--red);margin-left:4px">${compress}%</span></div>`:'—'}</td>
      <td style="color:var(--text2)">${s.adx||'—'}</td>
      <td style="color:var(--text2)">${s.vix_ratio||'—'}</td>
    </tr>`;
  }).join('');
}

function renderIndiaAnalytics() {
  const ft=filterByMode(indiaTrades);
  drawEquityCurve(ft,'i-equityCanvas','#4fffb0');
  const closed=ft.filter(t=>t.result&&!['open','skipped','failed'].includes(t.result));
  const wins=closed.filter(t=>t.result==='target');
  const losses=closed.filter(t=>t.result==='sl');
  const bes=closed.filter(t=>t.result==='be');
  const total=closed.length||1;
  const rb=document.getElementById('i-results-breakdown');
  rb.innerHTML=[{label:'Target Hit',count:wins.length,color:'var(--green)'},{label:'SL Hit',count:losses.length,color:'var(--red)'},{label:'Breakeven',count:bes.length,color:'var(--text2)'}].map(r=>`<div style="margin-bottom:12px;"><div style="display:flex;justify-content:space-between;margin-bottom:4px;"><span style="font-size:12px;color:var(--text2)">${r.label}</span><span style="font-size:12px;color:${r.color};font-weight:600">${r.count} (${((r.count/total)*100).toFixed(0)}%)</span></div><div style="height:6px;background:var(--bg4);border-radius:3px;overflow:hidden;"><div style="height:100%;width:${(r.count/total)*100}%;background:${r.color};border-radius:3px;"></div></div></div>`).join('');
  const stratWR={};
  closed.forEach(t=>{if(!stratWR[t.strategy])stratWR[t.strategy]={w:0,t:0};stratWR[t.strategy].t++;if(t.result==='target')stratWR[t.strategy].w++;});
  const swr=document.getElementById('i-strat-wr-breakdown');
  const swrEntries=Object.entries(stratWR).sort((a,b)=>(b[1].w/b[1].t)-(a[1].w/a[1].t));
  swr.innerHTML=swrEntries.length?swrEntries.map(([name,d])=>{const wr=((d.w/d.t)*100).toFixed(0);return`<div style="margin-bottom:10px;"><div style="display:flex;justify-content:space-between;margin-bottom:3px;"><span style="font-size:11px;color:var(--text2)">${name}</span><span style="font-size:11px;color:${wr>=60?'var(--green)':wr>=50?'var(--amber)':'var(--red)'}">${wr}% (${d.t})</span></div><div style="height:5px;background:var(--bg4);border-radius:3px;overflow:hidden;"><div style="height:100%;width:${wr}%;background:${wr>=60?'var(--green)':wr>=50?'var(--amber)':'var(--red)'};border-radius:3px;"></div></div></div>`}).join(''):'<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">No data</div>';
  const skipReasons={};
  filterByMode(indiaSkipped).forEach(s=>{const r=s.skip_reason||'other';skipReasons[r]=(skipReasons[r]||0)+1;});
  const sb=document.getElementById('i-skip-breakdown');
  const sbTotal=Object.values(skipReasons).reduce((a,b)=>a+b,0)||1;
  sb.innerHTML=Object.entries(skipReasons).sort((a,b)=>b[1]-a[1]).map(([reason,count])=>`<div style="margin-bottom:10px;"><div style="display:flex;justify-content:space-between;margin-bottom:3px;"><span style="font-size:11px;color:var(--amber)">${reason}</span><span style="font-size:11px;color:var(--text2)">${count} (${((count/sbTotal)*100).toFixed(0)}%)</span></div><div style="height:5px;background:var(--bg4);border-radius:3px;overflow:hidden;"><div style="height:100%;width:${(count/sbTotal)*100}%;background:var(--amber);border-radius:3px;"></div></div></div>`).join('')||'<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">No skips</div>';
  const totalPnl=ft.reduce((s,t)=>s+(t.pnl||0),0);
  const avgWin=wins.length?(wins.reduce((s,t)=>s+Math.abs(t.pnl||0),0)/wins.length).toFixed(0):0;
  const avgLoss=losses.length?(losses.reduce((s,t)=>s+Math.abs(t.pnl||0),0)/losses.length).toFixed(0):0;
  const best=ft.reduce((b,t)=>(t.pnl||0)>(b.pnl||0)?t:b,{pnl:0});
  const worst=ft.reduce((w,t)=>(t.pnl||0)<(w.pnl||0)?t:w,{pnl:0});
  document.getElementById('i-perf-summary').innerHTML=[
    {label:'Total P&L',val:(totalPnl>=0?'Rs.':'-Rs.')+Math.abs(Math.round(totalPnl)).toLocaleString('en-IN'),color:totalPnl>=0?'var(--green)':'var(--red)'},
    {label:'Avg Win',val:'Rs.'+Number(avgWin).toLocaleString('en-IN'),color:'var(--green)'},
    {label:'Avg Loss',val:'Rs.'+Number(avgLoss).toLocaleString('en-IN'),color:'var(--red)'},
    {label:'Best',val:'Rs.'+Math.abs(Math.round(best.pnl||0)).toLocaleString('en-IN'),color:'var(--green)'},
    {label:'Worst',val:'-Rs.'+Math.abs(Math.round(worst.pnl||0)).toLocaleString('en-IN'),color:'var(--red)'},
  ].map(s=>`<div style="text-align:center;background:var(--bg3);padding:14px;border-radius:8px;"><div style="font-size:10px;color:var(--text3);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;">${s.label}</div><div style="font-family:var(--font-head);font-size:18px;font-weight:700;color:${s.color}">${s.val}</div></div>`).join('');
}

// ══════════════════════════════════════════════════════════
// FOREX RENDER
// ══════════════════════════════════════════════════════════
function forexModeBadge(sig) {
  const m = (sig.mode||'paper').toLowerCase();
  return `<span style="padding:2px 7px;border-radius:4px;font-size:10px;background:${m==='live'?'rgba(79,255,176,0.1)':'rgba(255,184,48,0.1)'};color:${m==='live'?'var(--accent)':'var(--amber)'};">${m.toUpperCase()}</span>`;
}

function renderForexDashboard() {
  const ft = filterByMode(forexSignals);
  const WIN_OUTCOMES = ['tp_max','tp1','tp2_trail'];
  const closed = ft.filter(s => s.outcome && s.outcome !== null);
  const wins   = closed.filter(s => WIN_OUTCOMES.includes(s.outcome));
  const losses = closed.filter(s => s.outcome === 'sl_hit');
  const taken  = ft.filter(s => s.decision === 'entered');
  const pending= ft.filter(s => s.decision === 'pending' || !s.decision);
  const wr     = closed.length ? ((wins.length/closed.length)*100).toFixed(1) : 0;
  const totalPnl = ft.reduce((s,sig)=>s+(sig.pnl_usd||0),0);

  const skipped = ft.filter(s=>s.decision==='skipped');
  document.getElementById('f-stat-total').textContent = ft.length;
  document.getElementById('f-stat-total-sub').textContent = taken.length+' entered';
  document.getElementById('f-stat-wr').textContent = wr+'%';
  document.getElementById('f-stat-wr-sub').textContent = closed.length+' closed';
  const wlpEl = document.getElementById('f-stat-wlp');
  wlpEl.innerHTML = `<span style="color:var(--green)">${wins.length}</span> / <span style="color:var(--red)">${losses.length}</span> / <span style="color:var(--text2)">${pending.length}</span>`;
  document.getElementById('f-stat-wlp-sub').textContent = taken.length+' entered signals';
  document.getElementById('f-stat-pnl').textContent = (totalPnl>=0?'$':'-$')+Math.abs(totalPnl).toFixed(2);
  document.getElementById('f-stat-pnl').className = 'stat-value '+(totalPnl>=0?'green':'red');
  document.getElementById('f-stat-pnl-sub').textContent = wins.length+' wins · '+losses.length+' losses';
  document.getElementById('f-stat-open').textContent = pending.length+' / '+skipped.length;
  document.getElementById('f-stat-open-sub').textContent = 'pending / skipped';

  const circ = 251.2;
  document.getElementById('f-wr-circle-fill').style.strokeDashoffset = circ - (parseFloat(wr)/100)*circ;
  document.getElementById('f-wr-pct-text').textContent = wr+'%';
  document.getElementById('f-wr-wins').textContent = wins.length;
  document.getElementById('f-wr-losses').textContent = losses.length;
  document.getElementById('f-wr-pending').textContent = pending.length;

  renderForexStratBars(ft);
  renderForexSymbolBars(ft);

  const tbody = document.getElementById('f-recent-tbody');
  const empty = document.getElementById('f-recent-empty');
  const recent = [...ft].reverse().slice(0,10);
  if(!recent.length){tbody.innerHTML='';empty.style.display='block';return;}
  empty.style.display='none';
  tbody.innerHTML = recent.map(sig=>`<tr>
    <td style="color:var(--text3);font-size:11px">${(sig.time||'—').substring(0,16)}</td>
    <td style="color:var(--accent2);font-size:11px">${sig.strategy||'—'}</td>
    <td><span class="sym-badge">${sig.symbol||'—'}</span></td>
    <td><span class="dir-badge ${(sig.direction||'').toLowerCase()}">${sig.direction||'—'}</span></td>
    <td style="color:var(--text3)">${sig.timeframe||'—'}</td>
    <td>${sig.entry||'—'}</td>
    <td style="color:var(--red)">${sig.sl||'—'}</td>
    <td style="color:var(--green)">${sig.tp1||'—'}</td>
    <td style="color:var(--text2)">${sig.lot||'—'}</td>
    <td style="color:var(--amber)">$${sig.risk_usd||'—'}</td>
    <td style="color:${['tp_max','tp1','tp2_trail'].includes(sig.outcome)?'var(--green)':sig.outcome==='sl_hit'?'var(--red)':'var(--text3)'};font-size:11px">${sig.outcome||'—'}</td>
    <td><span class="result-badge ${(sig.decision||'pending').toLowerCase()}">${sig.decision||'pending'}</span></td>
    <td>${forexModeBadge(sig)}</td>
  </tr>`).join('');
}

function renderForexStratBars(ft) {
  const map={};
  (ft||filterByMode(forexSignals)).forEach(s=>{
    if(!map[s.strategy])map[s.strategy]={taken:0,total:0};
    map[s.strategy].total++;
    if(s.decision==='entered')map[s.strategy].taken++;
  });
  const container=document.getElementById('f-strat-bars');
  const entries=Object.entries(map).sort((a,b)=>b[1].total-a[1].total).slice(0,5);
  if(!entries.length){container.innerHTML='<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px">No data</div>';return;}
  const colors=['var(--accent2)','var(--accent)','var(--amber)','var(--purple)','var(--red)'];
  container.innerHTML=entries.map(([name,d],i)=>{
    const pct=((d.taken/d.total)*100).toFixed(0);
    return`<div class="strat-bar-row"><div class="strat-name-label" title="${name}">${name.replace('_',' ')}</div><div class="strat-bar-bg"><div class="strat-bar-fill" style="width:${pct}%;background:${colors[i]}"></div></div><div class="strat-pct-label">${d.total}</div></div>`;
  }).join('');
}

function renderForexSymbolBars(ft) {
  const map={};
  (ft||filterByMode(forexSignals)).forEach(s=>{map[s.symbol]=(map[s.symbol]||0)+1;});
  const total=Object.values(map).reduce((a,b)=>a+b,0)||1;
  const container=document.getElementById('f-symbol-bars');
  const colors=['var(--accent)','var(--accent2)','var(--amber)','var(--purple)'];
  container.innerHTML=Object.entries(map).sort((a,b)=>b[1]-a[1]).map(([sym,count],i)=>`<div class="strat-bar-row"><div class="strat-name-label">${sym}</div><div class="strat-bar-bg"><div class="strat-bar-fill" style="width:${(count/total)*100}%;background:${colors[i%colors.length]}"></div></div><div class="strat-pct-label">${count}</div></div>`).join('');
}

